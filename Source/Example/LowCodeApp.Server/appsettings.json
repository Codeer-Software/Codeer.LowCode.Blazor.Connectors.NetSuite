{
  "Mail": {
    "DefaultInfraName": "Gmail",
    "DefaultBulkInfraName": "Gmail",
    "HistoryModuleName": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataSources": [
    {
      "Name": "Main",
      "DataSourceType": "SQLite"
    },
    {
      "Name": "NetSuite",
      "DataSourceType": "Oracle"
    }
  ],
  "AIChat": {
    "RawDataAccessDataSources": [],
    "RawDataAccess": {
      "CommandTimeoutSeconds": 30,
      "MaxQuerySecondsPerReply": 0,
      "MaxConcurrentQueries": 0,
      "CancelQueryAtRowLimit": true,
      "LargeTableRows": 100000
    },
    "ModuleDataAccess": {
      "CommandTimeoutSeconds": 0,
      "MaxQuerySecondsPerReply": 0,
      "MaxConcurrentQueries": 0
    }
  },
  "AllowPasswordLogin": true,
  "LoginLockout": {
    "MaxFailedAttempts": 10,
    "LockoutMinutes": 5,
    "MaxLockoutMinutes": 1440
  },
  "MobileLoginCallbackUrl": "lowcodeapp://auth",
  "TotpLogin": {
    "Issuer": "LowCodeApp"
  },
  "AuditLog": {
    "Enabled": false,
    "FailureMode": "Strict",
    "Database": { "DataSourceName": "", "Table": "audit_log" },
    "File": { "Directory": "" }
  },
  "TemporaryFileTableInfo": [
    {
      "DataSourceName": "Main",
      "Table": "temporary_files",
      "GuidColumn": "guid",
      "CreatedDateTimeColumn": "created_date_time"
    }
  ],
  "Jobs": {
    "UserId": ""
  }
}
