<Project Sdk="Microsoft.NET.Sdk">

	<!-- Example の Web アプリ (LowCodeApp.Server) を起動して Chrome (ヘッドレス) で操作するテスト。モックはテストのプロセスの中に立てる -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- Codeer.LowCode.Blazor のフィールド/ページ用 Selenium ドライバ (PageObject が使う) -->
		<PackageReference Include="Codeer.LowCode.Blazor.SeleniumDrivers" Version="0.29.0" />
		<PackageReference Include="Selenium.StandardControls" Version="0.61.0" />
		<!-- デザインから App.zip を作る (DesignDataFileManager.CreateZipAsync) -->
		<PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.66" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="NUnit" Version="4.6.1" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
		<PackageReference Include="NUnit.Analyzers" Version="4.15.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- 参照パッケージが推移的に持ち込む脆弱な版を上書きする -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NetSuite.Mock\NetSuite.Mock.csproj" />
		<!-- 起動する Web アプリ。出力は参照しない (先にビルドされるようにするだけ) -->
		<ProjectReference Include="..\Example\LowCodeApp.Server\LowCodeApp.Server.csproj" ReferenceOutputAssembly="false" Private="false" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="NUnit.Framework" />
	</ItemGroup>

</Project>
